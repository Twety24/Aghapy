NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret from Supabase Project Settings > API Keys. Never expose it to the browser or commit it.
SUPABASE_SECRET_KEY=
# Legacy fallback during migration; replace with SUPABASE_SECRET_KEY before the end of 2026.
SUPABASE_SERVICE_ROLE_KEY=
# Keep false in production. Set true only while intentionally testing attendance flows.
ALLOW_TEST_SESSIONS=false
# Google OAuth web client credentials. Keep both values server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte (64 hex characters) random key used for AES-256-GCM token encryption.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Canonical deployed origin used to construct the Google OAuth callback URL.
APP_URL=https://aghapy-omega.vercel.app
# Long random bearer secret used by the scheduled session-closing endpoint.
CRON_SECRET=
