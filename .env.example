NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret from Supabase Project Settings > API Keys. Never expose it to the browser or commit it.
SUPABASE_SECRET_KEY=
# Legacy fallback during migration; replace with SUPABASE_SECRET_KEY before the end of 2026.
SUPABASE_SERVICE_ROLE_KEY=
# Keep false in production. Set true only while intentionally testing attendance flows.
ALLOW_TEST_SESSIONS=false
# Resend API key. This stays server-side.
RESEND_API_KEY=
# Required in production. Use a sender address from a domain verified in Resend.
MAIL_FROM=
# Long random bearer secret used by the scheduled session-closing endpoint.
CRON_SECRET=
